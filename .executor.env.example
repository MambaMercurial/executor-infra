# Executor secrets — copy to ~/.executor.env and fill in. NEVER commit the real file.
#   cp .executor.env.example ~/.executor.env && $EDITOR ~/.executor.env
# morning_pulse.sh does `source ~/.executor.env` before every run.

# From @BotFather → /newbot
export TELEGRAM_BOT_TOKEN=123456789:AA-your-bot-token-here

# Your personal chat id. Message your bot once, then visit
#   https://api.telegram.org/bot<TOKEN>/getUpdates
# and read result[].message.chat.id . Approvals are accepted ONLY from this id.
export TELEGRAM_CHAT_ID=987654321
