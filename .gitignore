# Secrets — the real env lives in ~/.executor.env, never in the repo.
.executor.env
*.env
!.executor.env.example

# Runtime / cron output
state/pulse.log
state/last_pulse.json
state/.pulse.lock

# Live trade proposals ARE tracked: they're the audit trail, and on Railway the
# repo image seeds the /data volume — untracked proposals would never reach the box.

# Python
__pycache__/
*.pyc
